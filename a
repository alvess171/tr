    // Calcula o tile adjacente na direÃ§Ã£o configurada (N/S/L/O) em relaÃ§Ã£o
    // ao player. Usado pra clicar no dummy quando ele nÃ£o Ã© uma criatura
    // rastreÃ¡vel pelo nome (ex: dummy de treino do chÃ£o).
    function tileNaDirecao() {
      const dir = String(config.direcao || "").trim().toLowerCase();
      if (!dir) return null;
      const me = bot.getPlayerPosition && bot.getPlayerPosition();
      if (!me) return null;
      let dx = 0, dy = 0;
      if (dir.includes("norte") || dir === "n" || dir === "up") dy = -1;
      else if (dir.includes("sul") || dir === "s" || dir === "down") dy = 1;
      else if (dir.includes("leste") || dir === "l" || dir === "e" || dir === "east" || dir === "right") dx = 1;
      else if (dir.includes("oeste") || dir === "o" || dir === "w" || dir === "west" || dir === "left") dx = -1;
      else return null;
      const world = window.gameClient?.world;
      if (!world) return null;
      const pos = { x: Number(me.x) + dx, y: Number(me.y) + dy, z: me.z };
      try {
        if (typeof world.getTileFromWorldPosition === "function") return world.getTileFromWorldPosition(pos);
        if (typeof world.getTile === "function") return world.getTile(pos);
        const mundo = world.world || world.map;
        if (mundo && typeof mundo.getTile === "function") return mundo.getTile(pos);
      } catch (e) {}
      return null;
    }

    // Tiles ao redor do player (radial N/S/L/O + diagonais), com raio config.
    function tilesAoRedor() {
      const me = bot.getPlayerPosition && bot.getPlayerPosition();
      if (!me) return [];
      const mundoAcesso = (pos) => {
        const world = window.gameClient?.world;
        if (!world) return null;
        try {
          if (typeof world.getTileFromWorldPosition === "function") return world.getTileFromWorldPosition(pos);
          if (typeof world.getTile === "function") return world.getTile(pos);
        } catch (e) {}
        return null;
      };
      const raio = Math.max(1, Math.min(4, Math.trunc(Number(config.raioBusca) || 1)));
      const tiles = [];
      for (let dy = -raio; dy <= raio; dy++) {
        for (let dx = -raio; dx <= raio; dx++) {
          if (dx === 0 && dy === 0) continue;
          const pos = { x: Number(me.x) + dx, y: Number(me.y) + dy, z: me.z };
          const t = mundoAcesso(pos);
          if (t) tiles.push({ tile: t, dx, dy });
        }
      }
      return tiles;
    }

    // Pega a primeira criatura (monster) do tile â€” o mesmo critÃ©rio que o
    // clique normal do mouse usa pra listar "monstros atacÃ¡veis" do tile:
    // qualquer coisa que nÃ£o seja o player nem NPC.
    function primeiroMonsterDoTile(tile) {
      if (!tile) return null;
      const fontes = [];
      if (tile.which?.monsters) fontes.push(tile.which.monsters);
      if (tile.monsters) fontes.push(tile.monsters);
      for (const f of fontes) {
        try {
          let arr = null;
          if (typeof f.values === "function") arr = f.values();
          else if (f instanceof Set || f instanceof Map) arr = Array.from(f.values());
          else if (f instanceof Array) arr = f;
          if (!arr) continue;
          for (const c of arr) {
            if (!c || c === window.gameClient?.player) continue;
            const tipo = c.type;
            const ehNpc = tipo === 3; // CONST.TYPES.NPC
            if (ehNpc) continue;
            const ehCreature = c.constructor && c.constructor.name === "Creature";
            if (ehCreature || c.isMonster || c.__position || typeof c.getPosition === "function") return c;
          }

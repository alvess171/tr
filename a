    const e = document.createElement(tag);
    if (style) e.style.cssText = style;
    if (text != null) e.textContent = text;
    return e;
  }

  function makeToggleButton(module, label) {
    const btn = el("button", "width:100%; padding:6px; border-radius:7px; cursor:pointer; font-weight:bold; color:#f1e8f8; margin-top:6px;");
    btn.classList.add("einpro-toggle-btn");
    function refresh() {
      btn.textContent = module.running ? "Stop " + label : "Start " + label;
      btn.classList.toggle("is-stop", module.running);
      btn.classList.toggle("is-start", !module.running);
      btn.style.background = "";
      btn.style.border = "";
    }
    btn.onclick = () => { module.running ? module.stop() : module.start(); refresh(); };
    refresh();
    btn.dataset.refreshable = "1";
    btn._refresh = refresh;
    return btn;
  }

  function makeField(labelText, value, onChange, type = "text") {
    const wrap = el("div", "margin-bottom:6px;");
    const label = el("div", "margin-bottom:2px;", labelText);
    label.classList.add("einpro-field-label");
    wrap.appendChild(label);
    const input = el("input", "width:100%; padding:4px; border-radius:6px; box-sizing:border-box;");
    input.type = type;
    input.value = value ?? "";
    input.onchange = () => onChange(input.value);
    wrap.appendChild(input);
    return wrap;
  }

  function makeSelect(labelText, options, selectedValue, onChange) {
    const wrap = el("div", "margin-bottom:6px;");
    const label = el("div", "margin-bottom:2px;", labelText);
    label.classList.add("einpro-field-label");
    wrap.appendChild(label);
    const select = el("select", "width:100%; padding:4px; border-radius:6px; box-sizing:border-box;");
    options.forEach((opt) => {
      const o = el("option", null, opt);
      o.value = opt;
      if (opt === selectedValue) o.selected = true;
      select.appendChild(o);
    });
    select.onchange = () => onChange(select.value);
    wrap.appendChild(select);
    return wrap;
  }


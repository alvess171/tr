  function pedirConfirmacao(botao, textoConfirmar, acao) {
    if (botao.__armado) {
      clearTimeout(botao.__t);
      botao.__armado = false;
      botao.textContent = botao.__textoOriginal;
      botao.style.background = botao.__bgOriginal;
      acao();
      return;
    }
    botao.__armado = true;
    botao.__textoOriginal = botao.__textoOriginal || botao.textContent;
    botao.__bgOriginal = botao.__bgOriginal || botao.style.background;
    botao.textContent = textoConfirmar;
    botao.style.background = "#a33";
    botao.__t = setTimeout(() => {
      botao.__armado = false;
      botao.textContent = botao.__textoOriginal;
      botao.style.background = botao.__bgOriginal;
    }, 4000);
  }


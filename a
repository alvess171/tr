    function atacarCriaturaProxima() {
      const world = window.gameClient?.world;
      const me = bot.getPlayerPosition && bot.getPlayerPosition();
      if (!me) return { ok: false };

      // 1) direÃ§Ã£o fixa, se configurada â€” clique REAL no canvas no tile dela.
      const off = offsetDaDirecao();
      if (off) {
        const tx = Number(me.x) + off.dx;
        const ty = Number(me.y) + off.dy;
        if (clicarNoCanvas(tx, ty)) {

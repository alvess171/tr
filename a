    // Clique "de verdade": dispara pointer/mouse com coordenadas no centro do
    // elemento. UI de jogo (Unity/Phaser/Godot) Ã s vezes ignora el.click().
    function clickDeVerdade(elm) {
      try {
        const r = elm.getBoundingClientRect();
        const x = Math.round(r.left + r.width / 2);
        const y = Math.round(r.top + r.height / 2);
        const alvo = elm;
        const evs = [
          ["pointerdown", { pointerId: 1, pointerType: "mouse", isPrimary: true, clientX: x, clientY: y, bubbles: true, cancelable: true }],
          ["mousedown", { button: 0, clientX: x, clientY: y, bubbles: true, cancelable: true, view: window }],
          ["pointerup", { pointerId: 1, pointerType: "mouse", isPrimary: true, clientX: x, clientY: y, bubbles: true, cancelable: true }],
          ["mouseup", { button: 0, clientX: x, clientY: y, bubbles: true, cancelable: true, view: window }],
          ["click", { button: 0, clientX: x, clientY: y, bubbles: true, cancelable: true, view: window }],

  function detectEquippedSlotNames() {
    const nomes = {};
    const eq = window.gameClient?.player?.equipment;
    if (!eq?.slots) return nomes;
    for (let i = 0; i < eq.slots.length; i++) {
      const item = eq.getSlotItem?.(i) || eq.slots[i]?.item;
      if (!item) continue;
      const code = item.sid ?? item.id ?? item.cid;
      const def = (window.gameClient?.itemDefinitionsByCid?.[code] ||
        window.gameClient?.itemDefinitionsBySid?.[item.sid] ||
        window.gameClient?.itemDefinitions?.[code]) || null;
      const st = String(def?.properties?.slotType || def?.properties?.slot || "").toLowerCase();
      let nome = "Slot " + i;
      if (/head|helmet|cap|helm/.test(st)) nome = "Helmet";
      else if (/necklace|amulet|neck|pesco/.test(st)) nome = "Amuleto";
      else if (/ring/.test(st)) nome = "Anel";
      else if (/shield/.test(st)) nome = "Shield";
      else if (/left/.test(st)) nome = "MÃƒÂ£o esquerda";
      else if (/right/.test(st)) nome = "MÃƒÂ£o direita";
      else if (/armor|body|chest/.test(st)) nome = "Armor";
      else if (/feet|boot|shoe/.test(st)) nome = "Boots";
      else if (/ammo|arrow|quiver|bolt|flecha/.test(st)) nome = "Flechas";
      else if (/back|backpack|bag/.test(st)) nome = "Mochila";
      else if (/leg/.test(st)) nome = "Legs";
      nomes[i] = nome;
    }
    return nomes;
  }


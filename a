    const playerPos = normalizePosition(bot.getPlayerPosition());
    if (!playerPos) return null;

    const allMonsters = (bot.xray?.getVisibleMonsters?.({ sameFloorOnly: false }) || [])
      .filter((m) => m && (!config.skillTrainOnMonster || isReachableSkillTrainTarget(m, playerPos)));
    
    // PRIMEIRO: procura o alvo que vocÃƒÂª jÃƒÂ¡ estava atacando, se estiver ferido

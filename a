        .einpro-panel .einpro-toggle-btn.is-start { background:rgba(186,56,255,0.35) !important; border:1px solid rgba(186,56,255,0.7) !important; }
        .einpro-panel .einpro-toggle-btn.is-stop { background:rgba(212,73,73,0.55) !important; border:1px solid rgba(255,120,120,0.6) !important; }
        .einpro-panel .einpro-toggle-btn.is-start:hover { background:rgba(186,56,255,0.5) !important; border-color:#ba38ff !important; }
        .einpro-panel .einpro-toggle-btn.is-stop:hover { background:rgba(255,90,90,0.7) !important; border-color:#ff7a7a !important; }
        .einpro-panel .einpro-field-label, .einpro-panel label, .einpro-panel .einpro-label {
          color:#bfbfbf !important; font-size:10px !important; text-transform:uppercase; letter-spacing:0.04em; font-weight:600;
        }
        .einpro-panel .einpro-section-title { color:#ba38ff !important; font-weight:700; text-transform:uppercase; font-size:11px; letter-spacing:0.04em; }
        .einpro-panel .einpro-card {
          background:rgba(255,255,255,0.035) !important;

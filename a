    // Offset de tile de uma direÃ§Ã£o configurada (N/S/L/O) em relaÃ§Ã£o ao player.
    function offsetDaDirecao() {
      const dir = String(config.direcao || "").trim().toLowerCase();
      if (!dir) return null;
      let dx = 0, dy = 0;
      if (dir.includes("norte") || dir === "n" || dir === "up") dy = -1;
      else if (dir.includes("sul") || dir === "s" || dir === "down") dy = 1;
      else if (dir.includes("leste") || dir === "l" || dir === "e" || dir === "east" || dir === "right") dx = 1;
      else if (dir.includes("oeste") || dir === "o" || dir === "w" || dir === "west" || dir === "left") dx = -1;
      else return null;
      return { dx, dy };
    }

    // Projeta uma posiÃ§Ã£o de mundo para coordenadas de pixel do canvas â€”
    // inversa da Canvas.getWorldCoordinates do jogo:
    //   worldTile = floor((xy/scaling) - moveOffset) + player - (7,5)
    // Logo: canvas.x = scaling.x * (tile.x - player.x + 7 + moveOffset.x)
    function projetoCanvas(tx, ty) {
      try {
        const gc = window.gameClient;
        const player = gc?.player;
        const screen = gc?.renderer?.screen;
        if (!player || !screen || typeof player.getMoveOffset !== "function") return null;
        const me = player.getPosition();
        if (!me) return null;
        const scaling = gc.interface.getSpriteScalingVector();
        if (!scaling || !scaling.x || !scaling.y) return null;
        const mo = player.getMoveOffset() || { x: 0, y: 0 };
        const canvas = screen.canvas;
        const rect = canvas.getBoundingClientRect();
        const px = scaling.x * (Number(tx) - Number(me.x) + 7 + Number(mo.x));
        const py = scaling.y * (Number(ty) - Number(me.y) + 5 + Number(mo.y));
        return { clientX: rect.left + px, clientY: rect.top + py, canvas, rect };
      } catch (e) { return null; }

  function isHazardFieldItem(item) {
    if (!item) return false;
    const id = getFieldItemId(item);
    if (walkOnFireConfig.FIELD_IDS.has(id)) return true;
    const name = getThingName(item);
    if (!name) return false;
    // Detecta por nome para funcionar em qualquer servidor (ex.: Pristine),
    // onde os IDs de campo perigoso diferem do Minibia.
    return /(campo|field).*(fogo|fire|energy|energia|venen|poison|ice|gelo|magic.?wall|wild.?growth|explosion|bomb)|fire field|energy field|poison field|magic wall|wild growth|explosion|avalanche/i.test(name);
  }

  function resolveWalkTile(w, x, y, z) {
    if (!w) return null;
    const direct = w.__getTileFromCoords?.(x, y, z) ?? w.getTile?.(x, y, z);
    if (direct) return direct;
    if (typeof Position === "function") {
      try { return w.getTileFromWorldPosition?.(new Position(x, y, z)) || null; } catch { return null; }
    }
    return null;
  }

  function applyWalkOnFirePatches() {
    const gc = window.gameClient;
    if (!gc) return;
    const itemProtos = new Set();
    const tileProtos = new Set();
    const pos = gc?.player?.__position;
    const w = gc?.world;
    if (pos && w) {
      for (let dx = -15; dx <= 15; dx++) {
        for (let dy = -11; dy <= 11; dy++) {
          const tile = resolveWalkTile(w, pos.x + dx, pos.y + dy, pos.z);
          if (!tile) continue;
          tileProtos.add(Object.getPrototypeOf(tile));
          const items = getTileItems(tile);
          for (const item of items) {
            if (item) itemProtos.add(Object.getPrototypeOf(item));
          }
        }
      }
    }
    const equip = gc?.player?.equipment;
    if (equip) {
      for (let i = 0; i < 10; i++) {
        const item = equip.slots?.[i]?.item;
        if (item) itemProtos.add(Object.getPrototypeOf(item));
      }
    }
    itemProtos.forEach(itemProto => {
      if (typeof itemProto?.isWalkable !== 'function' || itemProto.__wof_patched) return;
      itemProto.__wof_patched = true;
      const orig = itemProto.isWalkable;
      itemProto.isWalkable = function() {
        if (isHazardFieldItem(this)) return true;
        return orig.call(this);
      };
    });
    tileProtos.forEach(tileProto => {
      if (typeof tileProto?.isNotPathable !== 'function' || tileProto.__wof_patched) return;
      tileProto.__wof_patched = true;
      const orig = tileProto.isNotPathable;
      tileProto.isNotPathable = function() {
        const r = orig.call(this);
        if (!r) return false;
        try {
          const items = getTileItems(this);
          if (!items.some(item => isHazardFieldItem(item))) return r;
          const hasBlocker = items.some(item => {
            if (!item || isHazardFieldItem(item)) return false;
            if (item.blocking || item.blockPath || item.blockSolid || item.isBlocking?.() === true) return true;
            try { return typeof item.isWalkable === 'function' && item.isWalkable() === false; }
            catch (e) { return false; }
          });
          return hasBlocker ? r : false;
        } catch (e) { return r; }
      };
    });
  }

  function startWalkOnFireRescan() {
    if (walkOnFireConfig.patchTimerId != null) return;
    walkOnFireConfig.patchTimerId = window.setInterval(() => {
      try { applyWalkOnFirePatches(); } catch (e) { /* ignora */ }
    }, 1500);
  }


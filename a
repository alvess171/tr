    function calcularContaTitulo(texto) {
      if (!texto) return null;
      const tokens = normalizarTexto(texto).match(/(-?\d+(?:[.,]\d+)?)|([+\-*/xÃ—])/g);
      if (!tokens || tokens.length < 3) return null;
      let nums = [], ops = [];
      let esperaNumero = true;
      for (const tk of tokens) {
        if (/[+\-*/xÃ—]/.test(tk) && !esperaNumero && tk !== "-") {
          ops.push(tk === "Ã—" || tk === "x" ? "*" : tk);

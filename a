  // Detecta mobs feridos (com pouca vida) que fogem
  function isWoundedMob(creature) {
    if (!config.chaseWoundedMobs) return false;
    if (!creature) return false;
    
    const maxHealth = creature?.state?.maxHealth || creature?.maxHealth || creature?.maxHp || 100;
    const currentHealth = readCreatureHealth(creature);
    
    if (currentHealth <= 0 || maxHealth <= 0) return false;
    
    const healthPercent = (currentHealth / maxHealth) * 100;
    const woundedThreshold = Math.max(1, Math.min(99, Number(config.woundedHealthPercent) || 30));
    
    return healthPercent <= woundedThreshold;

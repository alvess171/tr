      const obj = gc?.[nome];
      if (!obj) return;
      const metodos = Object.getOwnPropertyNames(Object.getPrototypeOf(obj) || {})
        .concat(Object.keys(obj))
        .filter((k) => /use|click|open|double|pick/i.test(k));
      partes.push(nome + ": " + (metodos.join(" | ") || "(sem)"));
    });
    log("apis pra usar item â€” " + partes.join(" / "));
  }

  function getSlotObjectItem(which, index) {
    if (!which) return null;
    return (typeof which.getSlotItem === "function" ? which.getSlotItem(index) : null) || which.slots?.[index]?.item || null;
  }

  // Retorna SEMPRE um array com os containers abertos, mesmo se o cliente
  // expuser a propriedade como objeto/Set.
  function openedContainersArray() {
    const raw = window.gameClient?.player?.__openedContainers;
    if (!raw) return [];
    if (Array.isArray(raw)) return raw;
    try {
      if (typeof raw[Symbol.iterator] === "function") return Array.from(raw);
    } catch {}
    return Object.values(raw).filter((v) => v && typeof v === "object");
  }

  // Retorna lista de formas de disparar "usar item" neste cliente, em ordem.
  // Cada entrada: { nome, fn }. NÃƒÂ£o chama nada atÃƒÂ© vocÃƒÂª chamar fn().
  function candidatosAbrirBp(which, index) {
    const gc = window.gameClient;
    const mouse = gc?.mouse;
    const item = getSlotObjectItem(which, index);
    const t = { which, index };
    const out = [];
    const push = (nome, fn) => out.push({ nome, fn });
    if (mouse && typeof mouse.use === "function") push("mouse.use({which,index})", () => mouse.use(t));
    if (mouse && typeof mouse.useItem === "function") push("mouse.useItem({which,index})", () => mouse.useItem(t));
    if (mouse && item && typeof mouse.use === "function") push("mouse.use(item)", () => mouse.use(item));
    if (mouse && item && typeof mouse.useItem === "function") push("mouse.useItem(item)", () => mouse.useItem(item));
    if (gc?.interface && typeof gc.interface.useItem === "function") push("interface.useItem({which,index})", () => gc.interface.useItem(t));
    if (gc?.interface && typeof gc.interface.use === "function") push("interface.use({which,index})", () => gc.interface.use(t));
    if (gc?.input && typeof gc.input.useItem === "function") push("input.useItem({which,index})", () => gc.input.useItem(t));
    return out;
  }

  // ===== MÃƒâ€œDULO: GOLD SAFE (move item por ID da mochila para um slot do equipamento) =====
  const GoldSafe = (() => {
    const KEY = "goldsafe.config";
    const state = { running: false, timerId: null, movedCount: 0, lastLogKey: {}, bpRetry: 0, bpFails: 0, openingBpTimer: null };
    const config = Object.assign(
      { rules: [], tickMs: 30000, enabled: false, backpackSlot: 6 },
      bot.storage.get(KEY, {})
    );
    if (!Array.isArray(config.rules)) config.rules = [];
    config.rules = config.rules.filter((r) => r && Number.isFinite(Number(r.id)) && Number(r.id) > 0 && Number.isFinite(Number(r.slot)));
    // Migra o default antigo de 1s para 30s
    if (Number(config.tickMs) === 1000) config.tickMs = 30000;
    config.tickMs = Math.max(1000, Math.trunc(Number(config.tickMs) || 30000));
    config.backpackSlot = Math.max(0, Math.trunc(Number(config.backpackSlot) || 6));

    function persist() { bot.storage.set(KEY, { ...config }); }

    function getEquipment() { return window.gameClient?.player?.equipment || null; }
    function getOpenContainers() { return Array.from(window.gameClient?.player?.__openedContainers || []); }
    function getSlotItem(slot) { return getEquipment()?.getSlotItem?.(slot) || getEquipment()?.slots?.[slot]?.item || null; }
    function getItemSid(item) { return item ? Number(item?.sid ?? item?.id ?? NaN) : NaN; }

    function reschedule() {
      if (state.timerId != null) { clearTimeout(state.timerId); state.timerId = null; }
      state.timerId = window.setTimeout(tick, config.tickMs);
    }

    // Se nenhum container estÃƒÂ¡ aberto, tenta abrir a main backpack com UM clique
    // por check (nada de loop a cada 800ms: isso fazia abrir/fechar sem parar).
    // Sem confirmaÃƒÂ§ÃƒÂ£o imediata: abriu, o prÃƒÂ³ximo check (30s) jÃƒÂ¡ vÃƒÂª e nÃƒÂ£o clica.
    function ensureBackpackOpen() {
      const gc = window.gameClient;
      if (!gc?.player) return;
      if (openedContainersArray().length > 0 || containerWindowVisible()) return; // jÃƒÂ¡ ta aberta
      const slot = config.backpackSlot;
      const eq = gc.player?.equipment;
      const item = eq?.getSlotItem?.(slot);
      diagBpApis();
      const candidatos = candidatosAbrirBp(eq, slot);
      const cand = candidatos[0];
      if (!cand) {
        if (!state.bpDiagNoApi) {
          state.bpDiagNoApi = true;
          log("gold safe: sem API de usar item pra abrir a bp (" + (item ? "item ok no slot " + slot : "bp vazia no slot " + slot) + ")");
        }
        return;
      }
      cand.fn();
      log("gold safe: abrindo bp (" + cand.nome + ") â€” confirma no proximo check em " + Math.round(config.tickMs / 1000) + "s");
    }

    // Detector DOM estrito (janela de container do jogo, caso o cliente use DOM).
    // PadrÃƒÂ£o ÃƒÂ© estreito de propÃƒÂ³sito pra NÃƒÆ’O bater em divs genÃƒÂ©ricas da
    // interface do prÃƒÂ³prio bot (senÃƒÂ£o o reconectar acha que a bp jÃƒÂ¡ abriu).
    function containerWindowVisible() {
      try {
        const re = /(container|backpack|bp|inventory|depot|chest|bag)\s*[-_.]?(window|view|panel)|(container|bp|inventory)window/i;
        for (const elm of document.querySelectorAll("div,section,aside")) {
          const cls = String(elm.className || "") + " " + String(elm.id || "");
          if (!re.test(cls)) continue;
          if (elm.offsetParent === null) continue;
          const r = elm.getBoundingClientRect();
          if (r.width < 40 || r.width > 420 || r.height < 40 || r.height > 640) continue;
          return true;
        }
      } catch {}
      return false;
    }

    function throttleLog(chave, mensagem) {
      const agora = Date.now();
      if (state.lastLogKey[chave] && agora - state.lastLogKey[chave] < 5000) return;
      state.lastLogKey[chave] = agora;
      log(mensagem);
    }

    function findItemInContainers(id) {
      const idNum = Number(id);
      for (const c of getOpenContainers()) {
        const slots = c?.slots || [];
        for (let i = 0; i < slots.length; i++) {
          const item = c.getSlotItem?.(i) || slots[i]?.item;
          if (!item) continue;
          if (getItemSid(item) === idNum) {
            const count = (typeof item.getCount === "function" ? item.getCount() : item.count) || 1;
            return { container: c, slotIndex: i, item, count };
          }
        }
      }
      return null;
    }

    function tick() {
      if (!state.running) return;
      try {
        ensureBackpackOpen();
        config.rules.forEach((rule) => {
          const id = Number(rule.id);
          const slot = Number(rule.slot);
          if (!Number.isFinite(id) || id <= 0 || !Number.isFinite(slot)) return;
          const eq = getEquipment();
          if (!eq) return;
          const itemNoSlot = getSlotItem(slot);
          if (itemNoSlot && getItemSid(itemNoSlot) !== id) {
            throttleLog("slot-ocupado-" + slot, "gold safe: slot " + slot + " esta ocupado por outro item â€” nao mexer");
            return;
          }
          // Slot vazio OU jÃ¡ tem este item (restock): procura mais na bp
          const source = findItemInContainers(id);
          if (!source) {
            if (!itemNoSlot) throttleLog("sem-item-" + id, "gold safe: item " + id + " nao encontrado em container aberto");
            return;
          }
          const from = { which: source.container, index: source.slotIndex };
          const to = { which: eq, index: slot };
          if (window.ItemMovePacket && typeof window.gameClient?.send === "function") {
            window.gameClient.send(new ItemMovePacket(from, to, source.count || 1));
          } else if (typeof window.gameClient?.mouse?.sendItemMove === "function") {
            window.gameClient.mouse.sendItemMove(from, to, source.count || 1);
          } else {
            throttleLog("sem-api", "gold safe: nenhuma API de mover item disponivel (ItemMovePacket/mouse.sendItemMove)");
            return;
          }
          state.movedCount++;
          log("gold safe: item " + id + " -> slot " + slot + (itemNoSlot ? " (restock)" : ""));
        });
      } catch (e) {
        log("gold safe tick failed", e?.message);
      }
      updatePanel();
      if (state.running) reschedule();
    }

    function addRule(id, slot) {
      const idNum = Number(id);
      const slotNum = Number(slot);
      if (!Number.isFinite(idNum) || idNum <= 0 || !Number.isFinite(slotNum) || slotNum < 0) {
        log("gold safe: regra invalida", { id, slot });
        return false;
      }
      config.rules.push({ id: idNum, slot: slotNum });
      persist();
      log("gold safe: regra adicionada", { id: idNum, slot: slotNum });
      return true;
    }

    function removeRule(index) {
      if (index < 0 || index >= config.rules.length) return false;
      config.rules.splice(index, 1);
      persist();
      log("gold safe: regra removida", { index });
      return true;
    }

    function setIntervalSeconds(segundos) {
      const val = Math.max(1, Math.trunc(Number(segundos) || 30));
      config.tickMs = val * 1000;
      persist();
      log("gold safe: intervalo de verificacao = " + val + "s");
      return val;
    }

    function start() {
      if (state.running) return;
      state.running = true;
      config.enabled = true;
      persist();
      tick();
    }
    function stop() {
      state.running = false;
      config.enabled = false;
      persist();
      if (state.timerId != null) { clearTimeout(state.timerId); state.timerId = null; }
      if (state.openingBpTimer != null) { clearTimeout(state.openingBpTimer); state.openingBpTimer = null; }
      updatePanel();
    }

    function updateConfig(next = {}) {
      if ("backpackSlot" in next) next.backpackSlot = Math.max(0, Math.trunc(Number(next.backpackSlot) || 6));
      Object.assign(config, next);
      persist();
      return { ...config };
    }

    return {
      config, start, stop, addRule, removeRule, setIntervalSeconds, updateConfig,
      get running() { return state.running; },
      get movedCount() { return state.movedCount; },
    };
  })();

  // ===== MÃƒâ€œDULO: AMMO PICKUP (pega itens do chÃƒÂ£o no waypoint atual do cave e mantÃƒÂ©m qtd na mÃƒÂ£o) =====
  const GroundPickup = (() => {
    const KEY = "groundpickup.config";
    const state = { running: false, timerId: null, movedCount: 0, lastLogKey: {}, diagNoApi: false };

    const config = Object.assign(
      {
        enabled: false,
        tickMs: 1000,
        ids: [],
        handSlot: 5,
        handTarget: 5,
        maxRange: 2,
        openBpSlot: 6,
        pickPlayerTile: true,
        onlyWhenCaveRunning: true,
      },
      bot.storage.get(KEY, {})
    );
    config.tickMs = Math.max(250, Math.trunc(Number(config.tickMs) || 1000));
    config.handSlot = Math.max(0, Math.trunc(Number(config.handSlot) || 5));
    config.handTarget = Math.max(0, Math.trunc(Number(config.handTarget) || 5));
    config.maxRange = Math.max(0, Math.trunc(Number(config.maxRange) || 2));
    config.openBpSlot = Math.max(0, Math.trunc(Number(config.openBpSlot) || 6));
    if (!Array.isArray(config.ids)) config.ids = [];
    config.ids = config.ids.map((v) => Math.trunc(Number(v))).filter(Number.isFinite);

    function persist() { bot.storage.set(KEY, config); }

    function log(...args) { try { bot.log(...args); } catch (e) {} }

    function throttle(key, msg) {
      const now = Date.now();
      if (state.lastLogKey[key] && now - state.lastLogKey[key] < 10000) return;
      state.lastLogKey[key] = now;
      log(msg);
    }

    function getItemSid(item) {
      if (!item) return null;
      const code = item.sid != null ? item.sid : item.id;
      const n = Number(code);
      return Number.isFinite(n) ? n : null;
    }

    function getOpenContainersList() { return openedContainersArray(); }

    function getHandInfo() {
      const gc = window.gameClient;
      const eq = gc?.player?.equipment;
      const slot = config.handSlot;
      const target = config.handTarget;
      if (!eq) return { equipment: null, slot, target, count: 0, sid: null, empty: true, needs: false, missing: 0 };
      const item = getSlotObjectItem(eq, slot);
      const count = item ? ((typeof item.getCount === "function" ? item.getCount() : item.count) || 1) : 0;
      const needs = target > 0 && count < target;
      return { equipment: eq, slot, target, count, sid: item ? getItemSid(item) : null, empty: !item, needs, missing: Math.max(0, target - count) };
    }

    function sendMove(from, to, count) {
      const gc = window.gameClient;
      if (typeof window.ItemMovePacket === "function" && typeof gc?.send === "function") {
        gc.send(new window.ItemMovePacket(from, to, count));
        return true;
      }
      if (typeof gc?.mouse?.sendItemMove === "function") {
        gc.mouse.sendItemMove(from, to, count);
        return true;
      }
      log("ammo pickup: sem API de mover item (ItemMovePacket/mouse.sendItemMove)");
      return false;
    }

    function findContainerItemSlot(sid) {
      for (const c of getOpenContainersList()) {
        const slots = c?.slots || [];
        for (let i = 0; i < slots.length; i++) {
          const it = getSlotObjectItem(c, i);
          if (it && getItemSid(it) === sid) return { which: c, index: i };
        }
      }
      return null;
    }

    function findContainerEmptySlot() {
      for (const c of getOpenContainersList()) {
        const slots = c?.slots || [];
        for (let i = 0; i < slots.length; i++) {
          if (!getSlotObjectItem(c, i)) return { which: c, index: i };
        }
      }
      return null;
    }

    function getPlayerPos() {
      try { return bot.getPlayerPosition?.() || null; } catch (e) { return null; }
    }

    function withinRange(pos) {
      const p = getPlayerPos();
      if (!p || !pos) return false;
      if (p.z !== pos.z) return false;
      return Math.max(Math.abs(p.x - pos.x), Math.abs(p.y - pos.y)) <= config.maxRange;
    }

    function collectSpots() {
      const spots = [];
      const cave = bot.cave;
      const caveRunning = !!cave && typeof cave.status === "function" && !!cave.status().running;
      if (config.onlyWhenCaveRunning || caveRunning) {
        const w = cave?.getCurrentWaypoint?.();
        if (w && Number.isFinite(w.x) && Number.isFinite(w.y) && Number.isFinite(w.z)) spots.push({ x: w.x, y: w.y, z: w.z });
      }
      if (config.pickPlayerTile) {
        const p = getPlayerPos();
        if (p) spots.push({ x: p.x, y: p.y, z: p.z });
      }
      const seen = new Set();
      const out = [];
      for (const s of spots) {
        const key = s.x + "," + s.y + "," + s.z;
        if (seen.has(key)) continue;
        seen.add(key);
        out.push(s);
      }
      return out;
    }

    function tileHasMatch(pos) {
      const gc = window.gameClient;
      const tile = gc?.world?.getTileFromWorldPosition?.(new window.Position(pos.x, pos.y, pos.z));
      const items = Array.isArray(tile?.items) ? tile.items : [];
      return items.some((item) => config.ids.includes(getItemSid(item)));
    }

    function pickupTile(pos, budget) {
      const gc = window.gameClient;
      const tile = gc?.world?.getTileFromWorldPosition?.(new window.Position(pos.x, pos.y, pos.z));
      if (!tile) return 0;
      const items = Array.isArray(tile.items) ? tile.items : [];
      let moved = 0;
      for (let idx = 0; idx < items.length; idx++) {
        if (moved >= budget) break;
        const item = items[idx];
        if (!item) continue;
        const sid = getItemSid(item);
        if (sid == null || !config.ids.includes(sid)) continue;
        if (!moveGroundItem(tile, idx, item, sid)) continue;
        moved++;
      }
      return moved;
    }

    function moveGroundItem(tile, idx, item, sid) {
      const itemCount = (typeof item.getCount === "function" ? item.getCount() : item.count) || 1;
      const hand = getHandInfo();
      let to = null;
      let count = itemCount;
      if (hand.equipment && hand.target > 0 && (hand.empty || hand.sid === sid)) {
        to = { which: hand.equipment, index: hand.slot };
        count = Math.min(itemCount, hand.missing);
      }
      if (!to) {
        const stack = findContainerItemSlot(sid);
        if (stack) to = stack;
      }
      if (!to) {
        const empty = findContainerEmptySlot();
        if (empty) to = empty;
      }
      if (!to) {
        throttle("cheia", "ammo pickup: bp cheia, sem slot livre");
        return false;
      }
      const from = { which: tile, index: idx };
      const ok = sendMove(from, to, count);
      if (!ok) return false;
      state.movedCount += 1;
      const destino = hand.equipment && to.which === hand.equipment ? "mao" : "bp";
      log("ammo pickup: item " + sid + " chao -> " + destino, { count, pos: tile.getPosition?.() });
      return true;
    }

    function ensureOpen() {
      if (getOpenContainersList().length > 0) return;
      const gc = window.gameClient;
      if (!gc?.player || !gc.player.equipment) return;
      const slot = config.openBpSlot;
      const cand = candidatosAbrirBp(gc.player.equipment, slot)[0];
      if (cand) {
        cand.fn();
        log("ammo pickup: abrindo bp (" + cand.nome + ")");
      } else if (!state.diagNoApi) {
        state.diagNoApi = true;
        diagBpApis();
      }
    }

    function replenishHand() {
      const hand = getHandInfo();
      if (!hand.needs || !hand.equipment) return;
      const wantSid = hand.sid != null ? hand.sid : (config.ids.length ? config.ids[0] : null);
      if (wantSid == null) return;
      const src = findContainerItemSlot(wantSid);
      if (!src) return;
      const it = getSlotObjectItem(src.which, src.index);
      const have = it ? ((typeof it.getCount === "function" ? it.getCount() : it.count) || 1) : 0;
      const count = Math.min(have, hand.missing);
      if (count <= 0) return;
      const from = { which: src.which, index: src.index };
      const to = { which: hand.equipment, index: hand.slot };
      if (!sendMove(from, to, count)) return;
      state.movedCount += 1;
      log("ammo pickup: refil da mao (novo total ~" + (hand.count + count) + ")");
    }

    function tick() {
      if (!state.running) return;
      try {
        const gc = window.gameClient;
        if (!gc?.player) { reschedule(); return; }
        const spots = collectSpots();
        const nearSpots = spots.filter(withinRange);
        const groundReady = nearSpots.some(tileHasMatch);
        const hand = getHandInfo();
        const needHand = hand.needs;
        if (getOpenContainersList().length === 0 && (groundReady || needHand)) ensureOpen();
        let moved = 0;
        for (const s of nearSpots) {
          moved += pickupTile(s, 3 - moved);
          if (moved >= 3) break;
        }
        if (needHand) replenishHand();
      } catch (error) {
        log("ammo pickup: erro no tick", error?.message || error);
      }
      updatePanel();
      reschedule();
    }

    function reschedule() {
      if (state.timerId != null) clearTimeout(state.timerId);
      state.timerId = setTimeout(tick, config.tickMs);
    }

    function start() {
      if (state.running) return;
      state.running = true;
      config.enabled = true;
      persist();
      tick();
    }

    function stop() {
      state.running = false;
      config.enabled = false;
      persist();
      if (state.timerId != null) { clearTimeout(state.timerId); state.timerId = null; }
      updatePanel();
    }

    function updateConfig(next = {}) {
      const copy = { ...next };
      if ("handSlot" in copy) copy.handSlot = Math.max(0, Math.trunc(Number(copy.handSlot) || 5));
      if ("handTarget" in copy) copy.handTarget = Math.max(0, Math.trunc(Number(copy.handTarget) || 0));
      if ("maxRange" in copy) copy.maxRange = Math.max(0, Math.trunc(Number(copy.maxRange) || 2));
      if ("tickMs" in copy) copy.tickMs = Math.max(250, Math.trunc(Number(copy.tickMs) || 1000));
      if ("openBpSlot" in copy) copy.openBpSlot = Math.max(0, Math.trunc(Number(copy.openBpSlot) || 6));
      if (Array.isArray(copy.ids)) copy.ids = copy.ids.map((v) => Math.trunc(Number(v))).filter(Number.isFinite);
      Object.assign(config, copy);
      persist();
      return { ...config };
    }

    function addId(value) {
      const n = Math.trunc(Number(value));
      if (!Number.isFinite(n)) return false;
      if (config.ids.includes(n)) return false;
      config.ids.push(n);
      persist();
      return true;
    }

    function removeId(index) {
      const i = Math.trunc(Number(index));
      if (!Number.isFinite(i) || i < 0 || i >= config.ids.length) return false;
      config.ids.splice(i, 1);
      persist();
      return true;
    }

    return {
      config, start, stop, updateConfig, addId, removeId,
      get running() { return state.running; },
      get movedCount() { return state.movedCount; },
    };
  })();

  // ===== MÃƒâ€œDULO: LAG SAVER (detecta mundo parado por latÃƒÂªncia e desbuga clicando na seta) =====

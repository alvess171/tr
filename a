    try {
      window.gameClient?.world?.pathfinder?.findPath?.(from, new Position(pos.x, pos.y, pos.z));
      return true;
    } catch (error) {
      bot.log("auto attack: falha ao andar atÃƒÂ© a posiÃƒÂ§ÃƒÂ£o", error?.message || error);

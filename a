      `;
      document.head.appendChild(s);
    }
  } catch (e) {}
  // ===== SHIM MÃƒÂNIMO (funciona com ou sem window.minibiaBot) =====
  const externalBot = window.minibiaBot;
  const STORAGE_PREFIX = "allInOne.";

  let quietMode = localStorage.getItem(STORAGE_PREFIX + "performanceMode.quiet") === "true";

  function log(...args) {
    if (quietMode) return;
    console.log("[allInOne]", ...args);
  }

  const bot = {
    log,
    storage: {
      get(key, fallback = null) {
        if (externalBot?.storage?.get) return externalBot.storage.get(key, fallback);
        try {
          const raw = localStorage.getItem(STORAGE_PREFIX + key);
          return raw == null ? fallback : JSON.parse(raw);
        } catch {
          return fallback;
        }
      },
      set(key, value) {
        if (externalBot?.storage?.set) return externalBot.storage.set(key, value);
        localStorage.setItem(STORAGE_PREFIX + key, JSON.stringify(value));
        return value;
      },
      remove(key) {
        if (externalBot?.storage?.remove) return externalBot.storage.remove(key);
        localStorage.removeItem(STORAGE_PREFIX + key);
      },
    },
    sendChat(text) {
      if (externalBot?.sendChat) return externalBot.sendChat(text);
      if (!text) return false;
      const gc = window.gameClient;
      try {
        if (typeof gc?.interface?.sendSay === "function") {
          gc.interface.sendSay(String(text));
          log("sent chat:", text);
          return true;
        }
      } catch (e) { log("sendChat via sendSay falhou", e?.message); }
      const cm = gc?.interface?.channelManager;
      if (!cm || typeof cm.sendMessageText !== "function") return false;
      cm.sendMessageText(text);
      log("sent chat:", text);
      return true;
    },
    clickHotbar(index) {
      if (externalBot?.clickHotbar) return externalBot.clickHotbar(index);
      const btn = window.gameClient?.interface?.hotbarManager?.slots?.[index]?.canvas?.canvas;
      if (!btn) return false;
      btn.click();
      return true;
    },
    getPlayerState() {
      if (externalBot?.getPlayerState) return externalBot.getPlayerState();
      return window.gameClient?.player?.state || null;
    },
    getCapacity() {
      const s = bot.getPlayerState();
      const direto = Number(s?.capacity ?? s?.cap ?? s?.freeCapacity ?? s?.maxCapacity);
      if (Number.isFinite(direto) && direto > 0) return direto;
      // Fallback: lÃƒÂª da UI de equipamento ("Cap: 606")
      try {
        const txt = document.querySelector("#cap, [data-cap], .capacity")?.textContent
          || Array.from(document.querySelectorAll("div,span"))
               .find((e) => e.children.length === 0 && /^\s*Cap[:\s]/i.test(e.textContent || ""))?.textContent;
        const m = String(txt || "").match(/(\d[\d.,]*)/);
        if (m) return Number(m[1].replace(/[.,]/g, ""));
      } catch {}
      return null;
    },
    readSelfStats() {
      const p = window.gameClient?.player;
      const s = p?.state || null;
      function pick(obj, paths) {
        for (const path of paths) {
          if (!obj) continue;
          const val = path.split(".").reduce((acc, k) => (acc == null ? null : acc[k]), obj);
          if (val != null) {
            const n = Number(val);
            if (Number.isFinite(n)) return n;
          }
        }
        return null;
      }
      const get0 = (names) => {
        for (const name of names) {
          if (typeof p?.[name] === "function") {
            try { const v = Number(p[name]()); if (Number.isFinite(v)) return v; } catch {}
          }
        }
        return null;
      };
      let hp = pick(s, ["state.health", "currentHealth", "hitpoints", "hitPoints", "health", "hp", "healthPercent", "healthPercentage", "__health", "__hp"]);
      if (hp == null) hp = pick(p, ["state.health", "currentHealth", "hitpoints", "hitPoints", "health", "hp", "healthPercent", "healthPercentage", "__health", "__hp", "state.currentHealth", "state.hitpoints"]);
      if (hp == null) hp = get0(["getHealth", "getHp", "getHealthPercent", "getHealthPercentage", "getHitpoints", "getHitPoints"]);
      let maxHp = pick(s, ["state.maxHealth", "maxHealth", "maxHp", "maximumHealth", "hitpointsMax", "hitPointsMax", "__maxHealth", "__maxHp"]);
      if (maxHp == null) maxHp = pick(p, ["state.maxHealth", "maxHealth", "maxHp", "maximumHealth", "hitpointsMax", "hitPointsMax", "__maxHealth", "__maxHp", "state.maxHp"]);
      let mana = pick(s, ["state.mana", "mana", "currentMana", "__mana"]);
      if (mana == null) mana = pick(p, ["state.mana", "mana", "currentMana", "__mana", "state.currentMana", "manaCurrent"]);
      if (mana == null) mana = get0(["getMana", "getCurrentMana"]);
      let maxMana = pick(s, ["state.maxMana", "maxMana", "maxMad", "maximumMana", "__maxMana"]);
      if (maxMana == null) maxMana = pick(p, ["state.maxMana", "maxMana", "maximumMana", "__maxMana"]);
      return { hp, maxHp, hpPercent: (hp != null && maxHp > 0) ? (hp / maxHp) * 100 : null, mana, maxMana };
    },
    getPlayerSnapshot() {
      const st = bot.readSelfStats();
      return {
        health: st.hp ?? 0,
        maxHealth: st.maxHp ?? 0,
        mana: st.mana ?? 0,
        maxMana: st.maxMana ?? 0,
        capacity: bot.getCapacity(),
      };
    },
    getPlayerPosition() {
      if (externalBot?.getPlayerPosition) return externalBot.getPlayerPosition();
      return window.gameClient?.player?.getPosition?.() || null;
    },
    xray: {
      getVisibleMonsters(options = {}) {
        if (externalBot?.xray?.getVisibleMonsters) return externalBot.xray.getVisibleMonsters(options);
        const me = bot.getPlayerPosition();
        if (!me) return [];
        const myId = window.gameClient?.player?.id;
        return Object.values(window.gameClient?.world?.activeCreatures || {}).filter((c) => {
          if (!c || c.id === myId || c.type === 0) return false;
          const p = c.__position;
          if (!p) return false;
          if (options.sameFloorOnly && p.z !== me.z) return false;
          return Math.abs(p.x - me.x) <= 8 && Math.abs(p.y - me.y) <= 6;
        });
      },
      getVisiblePlayers(options = {}) {
        if (externalBot?.xray?.getVisiblePlayers) return externalBot.xray.getVisiblePlayers(options);
        const me = bot.getPlayerPosition();
        if (!me) return [];
        const myId = window.gameClient?.player?.id;
        return Object.values(window.gameClient?.world?.activeCreatures || {}).filter((c) => {
          if (!c || c.id === myId || c.type !== 0) return false;
          const p = c.__position;
          if (!p) return false;
          if (options.sameFloorOnly && p.z !== me.z) return false;
          return Math.abs(p.x - me.x) <= 8 && Math.abs(p.y - me.y) <= 6;
        });
      },
    },
    addCleanup(fn) {
      if (typeof fn === "function") cleanupFns.push(fn);
    },
    // Gera um WAV de bipe em memÃƒÂ³ria. Elemento <audio> ÃƒÂ© bem mais
    // compatÃƒÂ­vel que Web Audio: funciona em setups onde a saÃƒÂ­da do
    // AudioContext nÃƒÂ£o chega no alto-falante.
    makeBeepWav(freq = 880, ms = 180, bips = 3, volume = 0.5) {
      const sampleRate = 8000;
      const totalMs = bips * (ms + 120);
      const n = Math.floor((sampleRate * totalMs) / 1000);
      const buf = new ArrayBuffer(44 + n);
      const dv = new DataView(buf);
      const ws = (o, str) => { for (let i = 0; i < str.length; i++) dv.setUint8(o + i, str.charCodeAt(i)); };
      ws(0, "RIFF"); dv.setUint32(4, 36 + n, true); ws(8, "WAVE"); ws(12, "fmt ");
      dv.setUint32(16, 16, true); dv.setUint16(20, 1, true); dv.setUint16(22, 1, true);
      dv.setUint32(24, sampleRate, true); dv.setUint32(28, sampleRate, true);
      dv.setUint16(32, 1, true); dv.setUint16(34, 8, true);
      ws(36, "data"); dv.setUint32(40, n, true);

      const amostrasPorBip = Math.floor((sampleRate * ms) / 1000);
      const amostrasPorCiclo = Math.floor((sampleRate * (ms + 120)) / 1000);
      for (let i = 0; i < n; i++) {
        const pos = i % amostrasPorCiclo;
        let v = 128;
        if (pos < amostrasPorBip) {
          const onda = Math.sin((2 * Math.PI * freq * i) / sampleRate) >= 0 ? 1 : -1;
          v = 128 + Math.round(onda * 127 * Math.min(1, Math.max(0, volume)));
        }
        dv.setUint8(44 + i, v);
      }
      let bin = "";
      const bytes = new Uint8Array(buf);
      for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
      return "data:audio/wav;base64," + btoa(bin);
    },

    playAlarm(opcoes = {}) {
      const freq = Number(opcoes.freq) || 880;
      const bips = Number(opcoes.bips) || 3;
      const volume = opcoes.volume != null ? Number(opcoes.volume) : 0.5;

      // Ã¢â€â‚¬Ã¢â€â‚¬ Caminho 1: elemento <audio> (mais confiÃƒÂ¡vel) Ã¢â€â‚¬Ã¢â€â‚¬
      try {
        // Se o elemento saiu do DOM (reconexÃƒÂ£o do jogo redesenha coisas)
        // ou entrou em erro, recria. Era isso que fazia o som "parar
        // de funcionar depois de um tempo".
        if (bot.__alarmEl && (!bot.__alarmEl.isConnected || bot.__alarmEl.error)) {
          try { bot.__alarmEl.remove(); } catch {}
          bot.__alarmEl = null;
        }
        if (!bot.__alarmEl) {
          const el = document.createElement("audio");
          el.id = "allInOne-alarm-audio";
          el.style.display = "none";
          document.body.appendChild(el);
          bot.__alarmEl = el;
        }
        const el = bot.__alarmEl;
        const chave = freq + "|" + bips + "|" + volume;
        if (el.__chave !== chave) {
          el.src = bot.makeBeepWav(freq, 180, bips, volume);
          el.__chave = chave;
        }
        el.volume = 1;
        el.currentTime = 0;
        const p = el.play();
        if (p?.catch) p.catch(() => bot.armAlarmUnlock());
      } catch (e) { log("playAlarm (audio el) falhou", e?.message || e); }

      // Ã¢â€â‚¬Ã¢â€â‚¬ Caminho 2: Web Audio, como reforÃƒÂ§o Ã¢â€â‚¬Ã¢â€â‚¬
      try {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (!AC) return;
        // Contexto fechado pelo navegador: recria em vez de falhar calado
        if (bot.__alarmCtx && bot.__alarmCtx.state === "closed") bot.__alarmCtx = null;
        if (!bot.__alarmCtx) bot.__alarmCtx = new AC();
        const ctx = bot.__alarmCtx;
        const tocar = () => {
          for (let i = 0; i < bips; i++) {
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = "square";
            osc.frequency.value = freq;
            osc.connect(gain);
            gain.connect(ctx.destination);
            const startAt = ctx.currentTime + i * 0.3;
            gain.gain.setValueAtTime(volume, startAt);
            osc.start(startAt);
            osc.stop(startAt + 0.15);
          }
        };
        if (ctx.state === "suspended") ctx.resume().then(tocar).catch(() => bot.armAlarmUnlock());
        else tocar();
      } catch (e) { log("playAlarm (web audio) falhou", e?.message || e); }
    },

    // Navegador sÃƒÂ³ libera ÃƒÂ¡udio depois de um toque. Isso arma o
    // desbloqueio no prÃƒÂ³ximo toque/clique, uma vez sÃƒÂ³.
    armAlarmUnlock() {
      if (bot.__alarmUnlockArmed) return;
      bot.__alarmUnlockArmed = true;
      const desbloquear = () => {
        try {
          const AC = window.AudioContext || window.webkitAudioContext;
          if (!bot.__alarmCtx && AC) bot.__alarmCtx = new AC();
          bot.__alarmCtx?.resume?.();
          // destrava tambÃƒÂ©m o elemento <audio> (toca mudo uma vez)
          if (bot.__alarmEl) {
            const v = bot.__alarmEl.volume;
            bot.__alarmEl.volume = 0;
            bot.__alarmEl.play?.().then(() => {
              bot.__alarmEl.pause();
              bot.__alarmEl.currentTime = 0;
              bot.__alarmEl.volume = v;
            }).catch(() => { bot.__alarmEl.volume = v; });
          }
          log("alarme liberado Ã¢â‚¬â€ o som jÃƒÂ¡ funciona");
        } catch {}
        // SÃƒÂ³ desarma se realmente destravou; senÃƒÂ£o continua tentando
        if (bot.__alarmCtx?.state === "running") {
          document.removeEventListener("touchend", desbloquear, true);
          document.removeEventListener("mousedown", desbloquear, true);
          bot.__alarmUnlockArmed = false;
        }
      };
      document.addEventListener("touchend", desbloquear, true);
      document.addEventListener("mousedown", desbloquear, true);
    },

    // Aviso dentro do painel. NÃƒÆ’O usa alert()/confirm(): esses congelam
    // o JavaScript da pÃƒÂ¡gina inteira, o heartbeat do jogo nÃƒÂ£o roda e a
    // conexÃƒÂ£o cai ("no server packets for 20s, forcing reconnect").
    toast(texto, cor) {
      try {
        let el = document.getElementById("allInOne-toast");
        if (!el) {
          el = document.createElement("div");
          el.id = "allInOne-toast";
          Object.assign(el.style, {
            position: "fixed", bottom: "16px", left: "50%",
            transform: "translateX(-50%)", background: "#1e1e1e",
            border: "1px solid #444", color: "#eee", padding: "8px 14px",
            borderRadius: "6px", fontSize: "12px", fontFamily: "sans-serif",
            zIndex: "9999999", pointerEvents: "none", maxWidth: "88vw",
            whiteSpace: "pre-line", textAlign: "center",
            boxShadow: "0 2px 10px rgba(0,0,0,0.5)", transition: "opacity .3s",
          });
          document.body.appendChild(el);
        }
        el.style.borderColor = cor || "#444";
        el.style.opacity = "1";
        el.textContent = texto;
        clearTimeout(el.__t);
        el.__t = setTimeout(() => { el.style.opacity = "0"; }, 4000);
      } catch {}
    },

    // Teste manual do alarme (serve pra liberar o ÃƒÂ¡udio tambÃƒÂ©m)
    testAlarm() {
      bot.playAlarm();
      const r = {
        webAudio: bot.__alarmCtx?.state || "sem contexto",
        elementoAudio: bot.__alarmEl ? (bot.__alarmEl.paused ? "pausado" : "tocando") : "nÃƒÂ£o criado",
        abaMuda: document.querySelector("audio")?.muted ? "sim" : "nÃƒÂ£o",
      };
      console.table([r]);
      return r;
    },
  };

  // Destrava o ÃƒÂ¡udio no PRIMEIRO toque/clique da sessÃƒÂ£o. Sem isso o
  // alarme sÃƒÂ³ falha na hora que importa: no iOS o contexto precisa ser
  // liberado durante um gesto do usuÃƒÂ¡rio, e um alarme automÃƒÂ¡tico nÃƒÂ£o ÃƒÂ©.
  setTimeout(() => { try { bot.armAlarmUnlock(); } catch {} }, 0);
  const cleanupFns = [];

  // Declarados aqui em cima (nÃƒÂ£o lÃƒÂ¡ embaixo, perto do painel) porque mÃƒÂ³dulos
  // com enabled:true salvo de sessÃƒÂµes anteriores chamam updatePanel() assim
  // que sÃƒÂ£o definidos Ã¢â‚¬â€ se essas variÃƒÂ¡veis sÃƒÂ³ existissem mais abaixo no
  // arquivo, isso geraria "Cannot access before initialization".
  let panelEl, bodyEl, tabsEl, contentWrapEl;
  let dragLock = false; // trava recÃƒÂ¡lculo de tamanho enquanto arrasta
  let lastViewportWidth = window.innerWidth;
  const PANEL_WIDTH = 260; // largura fixa Ã¢â‚¬â€ nunca "auto", senÃƒÂ£o estica pra caber as abas

  // ===== MÃƒâ€œDULO: RUNE MAKER =====
  const Rune = (() => {
    const KEY = "rune.config";
    const state = { running: false, timerId: null, lastRuneAt: 0 };
    const config = Object.assign(
      { minHpPercent: 50, minFoodSeconds: 30, runeSpellWords: "adori vita vis", runeManaMin: 600, runeManaMax: 600, runeCooldownMs: 3500, enabled: false },
      bot.storage.get(KEY, {})
    );
    let nextThreshold = null;

    function persist() { bot.storage.set(KEY, { ...config }); }

    function rollThreshold() {
      const min = Math.min(config.runeManaMin, config.runeManaMax);
      const max = Math.max(config.runeManaMin, config.runeManaMax);
      nextThreshold = min === max ? min : Math.floor(Math.random() * (max - min + 1)) + min;
      return nextThreshold;
    }

    function readStats() {
      const st = bot.readSelfStats();
      const hp = st.hp != null ? { current: st.hp, max: st.maxHp ?? 0 } : null;
      const mana = st.mana != null ? { current: st.mana, max: st.maxMana ?? 0 } : null;
      const foodText = document.querySelector('#skill-window div[skill="food"] .skill')?.textContent?.trim() || null;
      let food = null;
      if (foodText) {
        const m = foodText.match(/^(\d{1,2}):(\d{2})$/);
        food = m ? { seconds: Number(m[1]) * 60 + Number(m[2]) } : { seconds: null };
      }
      return { hp, mana, food };
    }

    function canMake() {
      const { hp, mana, food } = readStats();
      if (!hp || !mana) return false;
      const hpPct = hp.max > 0 ? (hp.current / hp.max) * 100 : 0;
      const threshold = nextThreshold ?? rollThreshold();
      const enoughFood = food?.seconds == null || food.seconds >= config.minFoodSeconds;
      const cooldownOk = Date.now() - state.lastRuneAt >= config.runeCooldownMs;
      return hpPct >= config.minHpPercent && mana.current >= threshold && enoughFood && cooldownOk;
    }

    function tick() {
      if (!state.running) return;
      try {
        if (canMake()) {
          if (bot.sendChat(config.runeSpellWords)) {
            state.lastRuneAt = Date.now();
            rollThreshold();
          }
        }
      } catch (e) { log("rune tick failed", e?.message); }
      updatePanel();
      state.timerId = window.setTimeout(tick, 250);
    }

    function start() {
      if (state.running) return;
      state.running = true; config.enabled = true; persist();
      rollThreshold(); tick();
    }
    function stop() {
      state.running = false; config.enabled = false; persist();

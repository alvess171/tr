    // Fila: cada entrada tem os containers abertos naquele instante + profundidade.
    // A cada passo abre todas as backpacks dentro dos containers atuais, espera
    // os containers novos abrirem, e repete atÃƒÂ© a profundidade mÃƒÂ¡xima.
    function openAllBackpacks() {
      const gc = window.gameClient;
      if (!gc?.player) return;
      const depth = Math.max(1, Math.trunc(Number(config.openBackpacksDepth) || 2));
      if (depth < 1) return;
      const delay = Math.max(0, Number(config.openBackpacksDelayMs) || 0);

      const containersSeen = new Set();
      const seenKeys = new Set();
      let step = 0;

      const isContainerItem = (it) => it && typeof it.isContainer === "function" && it.isContainer();

      const collectVisibleContainers = () => openedContainersArray();

      const processStep = () => {
        if (step >= depth) return;
        step += 1;
        // Atualiza o conjunto de containers jÃƒÂ¡ vistos
        collectVisibleContainers().forEach((c) => {
          const id = c.__containerId ?? c.id;
          if (id != null) containersSeen.add(id);
        });

        // Recolhe as backpacks (items container) nos containers abertos e na main
        const toOpen = [];
        collectVisibleContainers().forEach((c) => {
          const id = c.__containerId ?? c.id;
          const slots = c.slots || [];
          for (let i = 0; i < slots.length; i += 1) {
            const item = c.getSlotItem?.(i);
            if (isContainerItem(item)) {
              const ik = (id != null ? id : "?") + ":" + i;
              if (!seenKeys.has(ik)) {
                seenKeys.add(ik);
                toOpen.push({ which: c, index: i, item });
              }
            }
          }
        });
        // A main backpack jÃƒÂ¡ ÃƒÂ© garantida aberta antes (openMainBackpackUntilOpen).
        // NÃƒÂ£o re-usa aqui: `use` em bp aberta fecha (toggle).

        if (!toOpen.length) {
          log("autoReconnect: abertura de backpacks concluÃƒÂ­da", { profundidadeMax: depth, containers: containersSeen.size });
          return;
        }
        toOpen.forEach((entry) => {
          const cand = candidatosAbrirBp(entry.which, entry.index)[0];
          if (cand) cand.fn();
        });
        log("autoReconnect: abrindo " + toOpen.length + " backpack(s)", { step, profundidadeMax: depth });


    // Tenta abrir a main backpack (slot do corpo) e SÃƒâ€œ volta quando ela
    // realmente abriu (um container novo apareceu) ou estourou as tentativas.
    function openMainBackpackUntilOpen(opts = {}) {
      const gc = window.gameClient;
      if (!gc?.player) { log("autoReconnect: sem gameClient/player pra abrir bp"); return; }
      const slot = Math.max(0, Math.trunc(Number(config.backpackSlot) || 6));
      const attempts = Math.max(1, Math.trunc(Number(opts.attempts) || 8));
      const delay = Math.max(300, Number(opts.delayMs) || 1000);
      const onDone = typeof opts.onDone === "function" ? opts.onDone : null;
      const idsAntes = new Set(openedContainersArray().map((c) => c.__containerId ?? c.id));
      const jaTinha = idsAntes.size > 0;
      let tentativas = 0;

      const tentar = () => {
        tentativas += 1;
        const eq = gc.player?.equipment;
        const item = eq?.getSlotItem?.(slot);
        if (!eq || !item) {
          if (tentativas < attempts) { window.setTimeout(tentar, delay); return; }
          log("autoReconnect: nao achei a main backpack no slot " + slot + " (tentei " + tentativas + "x)");
          onDone?.(false);
          return;

  // Decide se o bicho conta pra pausa/lure. Sem isso, qualquer criatura
  // na tela (inclusive as que vocÃƒÂª nem ataca) travava a rota.
  function contaParaPausa(criatura) {
    const nome = getNomeCriatura(criatura);

    if (config.usarListaAttack) {
      const alvos = normalizeNomes(bot.attack?.config?.targetNames);
      const ignorados = normalizeNomes(bot.attack?.config?.ignoreNames);
      if (nome && ignorados.includes(nome)) return false;
      if (alvos.length) return !!nome && alvos.includes(nome);
      return true;
    }

    // SEMPRE verifica os ignorados do Attack, mesmo quando usarListaAttack estÃƒÂ¡ OFF
    // Isso evita contar mobs que estÃƒÂ£o na lista de ignorar do Attack
    const ignoradosAttack = normalizeNomes(bot.attack?.config?.ignoreNames);
    if (nome && ignoradosAttack.includes(nome)) return false;

    // Ignorados locais do Cave tÃƒÂªm prioridade: quem estÃƒÂ¡ aqui nunca conta, mesmo
    // estando tambÃƒÂ©m na lista de permitidos.
    const ignoradosCave = normalizeNomes(config.pauseIgnoreNames);
    if (nome && ignoradosCave.includes(nome)) return false;

    const permitidos = normalizeNomes(config.pauseMonsterNames);
    if (!permitidos.length) return true;   // lista vazia = todos contam
    return !!nome && permitidos.includes(nome);

    // localStorage nÃƒÂ£o atualiza quem jÃƒÂ¡ estÃƒÂ¡ rodando Ã¢â‚¬â€ precisa reaplicar.
    function getConfigTargets() {
      return [
        ["rune.config", Rune], ["haste.config", Haste], ["eat.config", Eat],
        ["ring.config", Ring], ["monk.config", Monk], ["stones.config", Stones], ["goldsafe.config", GoldSafe], ["groundpickup.config", GroundPickup], ["lagsaver.config", LagSaver],
        ["panic.config", Panic], ["heal.config", Heal],

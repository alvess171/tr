  const DefenseMode = (() => {
    const config = bot.storage.get('defenseMode.config', {
      enabled: false,
      defenseTriggerHP: 40,
      recoverToHP: 70,
      defensiveAmuletID: 3081,
      offensiveAmuletID: 3090,
      useFullDef: true,
      useFullAtk: true
    });

    function getAmuletSlot() {
      const gc = window.gameClient;
      const equip = gc?.player?.equipment;
      if (!equip || !equip.slots) return -1;
      for (let i = 0; i < equip.slots.length; i++) {
        const slot = equip.slots[i];
        if (slot && slot.item) {
          return i; // Retorna o ÃƒÂ­ndice do slot com item
        }
      }
      return -1;
    }

    function findItemInInventory(itemId) {
      const gc = window.gameClient;
      const inv = gc?.player?.inventory;
      if (!inv || !inv.items) return null;
      return inv.items.find(item => item && item.id === itemId);
    }

    function equipAmulet(itemId) {
      const item = findItemInInventory(itemId);
      if (!item) {
        console.log('[Defense Mode] Ã¢ÂÅ’ Amulet ID', itemId, 'nÃƒÂ£o encontrado no inventÃƒÂ¡rio');
        return false;
      }

      try {
        const gc = window.gameClient;
        // Enviar comando para equipar
        if (gc?.sendPacket) {
          gc.sendPacket(new (window.UseItemPacket || window.ItemUsePacket)({ item: item, index: item.index || 0 }));
          console.log('[Defense Mode] Ã¢Å“â€¦ Equipando amulet ID', itemId);
          return true;
        }
      } catch(e) {
        console.error('[Defense Mode] Erro ao equipar:', e.message);
      }
      return false;
    }

    function sendFullDef() {
      const gc = window.gameClient;
      try {
        if (gc?.interface?.sendSay) {
          gc.interface.sendSay('!fulldefense');
          console.log('[Defense Mode] Ã°Å¸â€ºÂ¡Ã¯Â¸Â Enviado: !fulldefense');
          return true;
        }
      } catch(e) {}
      return false;
    }

    function sendFullAtk() {
      const gc = window.gameClient;
      try {
        if (gc?.interface?.sendSay) {
          gc.interface.sendSay('!fullattack');
          console.log('[Defense Mode] Ã¢Å¡â€Ã¯Â¸Â Enviado: !fullattack');
          return true;
        }
      } catch(e) {}
      return false;
    }

    let lastState = null; // 'defense' ou 'attack'

    function update() {
      if (!config.enabled) return;

      const gc = window.gameClient;
      const player = gc?.player;
      if (!player || !player.state) return;

      const maxHP = player.state.maxHealth || 100;
      const currentHP = player.state.__state?.health || maxHP;
      const hpPercent = (currentHP / maxHP) * 100;

      // Ir para DEFENSE quando HP cair
      if (hpPercent <= config.defenseTriggerHP && lastState !== 'defense') {
        console.log('[Defense Mode] Ã°Å¸â€ºÂ¡Ã¯Â¸Â HP baixou para', Math.round(hpPercent), '% - Ativando defesa');
        equipAmulet(config.defensiveAmuletID);
        if (config.useFullDef) {
          setTimeout(() => sendFullDef(), 200);
        }
        lastState = 'defense';
      }
      // Voltar para ATTACK quando HP subir
      else if (hpPercent >= config.recoverToHP && lastState !== 'attack') {
        console.log('[Defense Mode] Ã¢Å¡â€Ã¯Â¸Â HP recuperou para', Math.round(hpPercent), '% - Ativando ataque');
        equipAmulet(config.offensiveAmuletID);
        if (config.useFullAtk) {
          setTimeout(() => sendFullAtk(), 200);
        }
        lastState = 'attack';
      }
    }

    setInterval(update, 500); // Verificar a cada 500ms

    return {
      config,
      update,
      getStatus() {
        const gc = window.gameClient;
        const player = gc?.player;
        if (!player || !player.state) return 'Sem player';
        const maxHP = player.state.maxHealth || 100;
        const currentHP = player.state.__state?.health || maxHP;
        const hpPercent = ((currentHP / maxHP) * 100).toFixed(1);
        return `HP: ${currentHP}/${maxHP} (${hpPercent}%)`;
      }
    };
  })();






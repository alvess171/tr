        const cands = candidatosAbrirBp(eq, slot);
        const cand = cands[(tentativas - 1) % (cands.length || 1)];
        if (cand) cand.fn();
        diagBpApis();
        window.setTimeout(() => {
          const idsDepois = new Set(openedContainersArray().map((c) => c.__containerId ?? c.id));
          const novoAberto = Array.from(idsDepois).some((id) => !idsAntes.has(id));

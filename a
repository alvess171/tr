  function getEngagedTarget() {
    const currentTarget = getCurrentTarget();
    if (currentTarget) {
      if (!isAllowedTarget(currentTarget)) {
        // skipTarget sÃƒÂ³ marca internamente Ã¢â‚¬â€ ÃƒÂ© preciso CANCELAR o alvo no
        // jogo, senÃƒÂ£o o personagem continua batendo no bicho ignorado.
